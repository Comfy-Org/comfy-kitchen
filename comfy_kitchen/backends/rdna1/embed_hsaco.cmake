# Writes OUT, a C++ source holding the code objects DIR/<name>.hsaco for each of NAMES, in
# order, as kWinoBlobs / kWinoBlobSizes (see fp32_winograd_conv2d in dlpack_bindings.cpp).
# Run as: cmake -DOUT=... -DDIR=... -DNAMES="a;b" -P embed_hsaco.cmake
set(body "// Generated by embed_hsaco.cmake from miopen_winograd/*.s.\n#include <cstddef>\n\nnamespace comfy::hip_backend {\n\n")
set(table "")
set(sizes "")
set(i 0)
foreach(name IN LISTS NAMES)
    file(READ "${DIR}/${name}.hsaco" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND body "static const unsigned char blob${i}[] = {${hex}};\n")
    string(APPEND table "blob${i}, ")
    string(APPEND sizes "sizeof(blob${i}), ")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "\nextern const unsigned char* const kWinoBlobs[] = {${table}};\n")
string(APPEND body "extern const size_t kWinoBlobSizes[] = {${sizes}};\n\n}  // namespace comfy::hip_backend\n")
file(WRITE "${OUT}" "${body}")
